# Maintainer: Steen Rabol <steen@rabol.dev>

pkgname=cosmic-ext-keybox-git
_pkgname=cosmic-ext-keybox
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Keyring manager for COSMIC: inspect secrets in your desktop keyring (development version)'
arch=('x86_64' 'aarch64')
url='https://github.com/rabol/cosmic-ext-keybox'
# Keybox is GPL-3.0-only. The other licenses are those of the crates
# compiled in (see THIRD-PARTY-LICENSES.md; `just licenses` lists them).
# Where a crate offers a choice, the permissive one is used.
license=('GPL-3.0-only' 'MIT' 'Apache-2.0' 'MPL-2.0' 'Unicode-3.0' 'Zlib' 'ISC'
         'BSD-3-Clause' 'BSD-2-Clause' 'Unlicense' 'CC0-1.0')
depends=('cosmic-icon-theme' 'glibc' 'libgcc' 'libxkbcommon')
makedepends=('cargo' 'git' 'just')
# makepkg's LTO can produce GCC LTO objects that Rust's linker can't read.
# Rust's own release optimisation is unaffected. No debug package: the
# release build has no debug info.
options=('!lto' '!debug')
# Keybox needs a running Secret Service provider, but does not pick one.
optdepends=(
  'oo7: Secret Service provider'
  'gnome-keyring: Secret Service provider'
  'kwallet: Secret Service provider (when its Secret Service interface is enabled)'
  'keepassxc: Secret Service provider (entries exposed by its integration only)'
  'xdg-utils: open the project page from About'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # v0.1.0-3-gabc1234 -> 0.1.0.r3.gabc1234; before the first tag: 0.1.0.rN.gHASH
  if git describe --long --tags --abbrev=7 >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The integration tests use a private bus and disposable keyrings; they
  # skip themselves when dbus-daemon or oo7-daemon is missing.
  cargo test --frozen
}

package() {
  cd "$_pkgname"
  export CARGO_TARGET_DIR=target
  just rootdir="$pkgdir" prefix=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-LICENSES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES.md"
  install -Dm644 docs/user-guide.md "$pkgdir/usr/share/doc/$pkgname/user-guide.md"
}
