# Maintainer: Steen Rabol <steen@rabol.dev>
#
# Builds the latest commit from GitHub. Keybox needs a running Secret
# Service provider, but does not force a particular one: see optdepends.

pkgname=cosmic-ext-keybox-git
_pkgname=cosmic-ext-keybox
pkgver=r0
pkgrel=1
pkgdesc='Keyring manager for COSMIC: inspect secrets in your desktop keyring'
arch=('x86_64' 'aarch64')
url='https://github.com/rabol/cosmic-ext-keybox'
license=('GPL-3.0-only')
depends=('cosmic-icon-theme' 'glibc' 'libgcc' 'libxkbcommon')
makedepends=('cargo' 'git' 'just')
optdepends=(
  'oo7: Secret Service provider'
  'gnome-keyring: Secret Service provider'
  'kwallet: Secret Service provider (when its Secret Service interface is enabled)'
  'keepassxc: Secret Service provider (entries exposed by its integration only)'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
options=('!lto')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "${_pkgname}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_pkgname}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  just build-release --frozen
}

check() {
  cd "${_pkgname}"
  export RUSTUP_TOOLCHAIN=stable
  # Integration tests need dbus-daemon and oo7-daemon; run the unit tests.
  cargo test --frozen --release --lib
}

package() {
  cd "${_pkgname}"
  just rootdir="${pkgdir}" install
}
