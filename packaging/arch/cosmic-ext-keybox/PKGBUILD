# Maintainer: Steen Rabol <steen@rabol.dev>
#
# Builds a tagged release from GitHub. Keybox needs a running Secret
# Service provider, but does not force a particular one: see optdepends.
#
# After tagging a new release, set pkgver and run `updpkgsums` to fill in
# the checksum of the release tarball.

pkgname=cosmic-ext-keybox
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyring manager for COSMIC: inspect secrets in your desktop keyring'
arch=('x86_64' 'aarch64')
url='https://github.com/rabol/cosmic-ext-keybox'
license=('GPL-3.0-only')
depends=('cosmic-icon-theme' 'glibc' 'libgcc' 'libxkbcommon')
makedepends=('cargo' 'just')
optdepends=(
  'oo7: Secret Service provider'
  'gnome-keyring: Secret Service provider'
  'kwallet: Secret Service provider (when its Secret Service interface is enabled)'
  'keepassxc: Secret Service provider (entries exposed by its integration only)'
)
conflicts=("${pkgname}-git")
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP') # replace with `updpkgsums` once the tag is pushed

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  just build-release --frozen
}

check() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # Integration tests need dbus-daemon and oo7-daemon; run the unit tests.
  cargo test --frozen --release --lib
}

package() {
  cd "${pkgname}-${pkgver}"
  just rootdir="${pkgdir}" install
}
